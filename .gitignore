# ── Python bytecode ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Virtualenv (NOT source; ~GB, must never be committed) ────────────
.venv/
venv/
env/

# ── Agent/editor worktrees and local config ──────────────────────────
# .kilo/worktrees/ is another agent's live checkout sharing this tree.
# Committing it would nest a second copy of the repo inside this one.
.kilo/
.kiro/
.vscode/

# ── Player roster data (EXCLUDED) ────────────────────────────────────
# PLOFA-2026-2027.xlsx is the real 26/27 squad workbook: 18 clubs, ~440
# players. It is NOT tracked here.
#
# CONSEQUENCE, stated so it is not a trap for whoever clones this: the engine
# cannot build a real squad without it. `roster_loader.EXCEL_FILE` points at
# this exact filename, `tests/test_weather_physics.py`, `test_world_ids.py`
# and `test_world_model.py` read it, and every probe in tools/diag/ calls
# `get_loader(XLSX)`. A fresh clone WILL fail those tests until the workbook is
# supplied. See ROSTER.md.
PLOFA-2026-2027.xlsx

# ── Excel lock files (0-byte, appear when the roster is open) ─────────
~$*.xlsx

# ── Generated match output ───────────────────────────────────────────
# Regenerated by every exporter run; large and not source.
plofa_output/
output/
__seq_export_check__/

# ── Probe scratch output ─────────────────────────────────────────────
# Diagnostics write _diag_*.txt / *.json / *.png beside the engine. They are
# evidence, not inputs, and there are hundreds. They now live in artifacts/
# (created 2026-10-05; ~600 files moved out of the root).
artifacts/
*.log
*.txt
*.png
# NB: the .txt/.png rules are deliberately broad because the repo root holds
# only .py, .md and the five live state files. Narrow them if the layout grows.

# ── State backups and corruption snapshots ───────────────────────────
# Every match run leaves season_state.json.pre-*, .corrupt-*, .backup-*
# behind. They are recovery copies, not source.
*.json.pre-*
*.json.corrupt-*
*.json.backup-*
*.json.pre-*
alltime.db.pre-*

# ── Live runtime state — TRACKED, and must stay at the repo root ─────
# These four filenames are HARDCODED: `SEASON_STATE_FILE = "season_state.json"`
# (auto_run_match.py:127), `PLOFA_DIR / "season_stats.json"`
# (build_app_data.py:26), and plofa_streamlit/app.py walks up to find them.
# Moving or ignoring them breaks the season runner, the app-data build and
# the world layer. Do not relocate these.
!/season_state.json
!/season_stats.json
!/manager_state.json
!/referee_state.json
!/world_state.json

# ── Databases ────────────────────────────────────────────────────────
# alltime.db is the warehouse: large, binary, rebuilt from exports.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Editor / OS noise ────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp